# FlavorFusion AI — Environment Configuration

PROJECT_NAME="FlavorFusion AI"
API_V1_STR="/api"

# JWT Secret Key
SECRET_KEY="super-flavor-fusion-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for seamless local setup, or PostgreSQL)
DATABASE_URL="sqlite:///./flavorfusion.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flavorfusion"

# Optional Cloud AI Integration
# If not provided, FlavorFusion AI automatically uses its robust local Computer Vision
# feature model and curated culinary formula recipe engine without any paid API keys.
GEMINI_API_KEY=""

# Uploads Configuration
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
